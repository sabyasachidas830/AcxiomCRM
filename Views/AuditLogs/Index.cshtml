@model IEnumerable<AcxiomCRM.Models.AuditLog>

@{
    ViewData["Title"] = "Audit Logs";
}

<div class="container mt-4">
    <h2>Audit Trail & System Logs</h2>
    <p class="text-muted">Tracking all security, insertion, and update events.</p>

    <table class="table table-bordered table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Timestamp (UTC)</th>
                <th>User</th>
                <th>Action</th>
                <th>Entity</th>
                <th>Record ID</th>
                <th>Details</th>
            </tr>
        </thead>
        <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var log in Model)
            {
                <tr>
                    <td>@log.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td><strong>@(log.UserId ?? "Anonymous")</strong></td>
                    <td><span class="badge bg-secondary">@log.Action</span></td>
                    <td>@log.EntityName</td>
                    <td>@(log.RecordId ?? "-")</td>
                    <td>@(log.NewValue ?? "-")</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center text-muted">No audit logs recorded yet.</td>
            </tr>
        }
        </tbody>
    </table>
</div>