@model AcxiomCRM.Models.Opportunity

@{
    ViewData["Title"] = "Add Opportunity";
}

<div class="container mt-4" style="max-width: 650px;">
    <h2>Create Opportunity</h2>
    <hr />

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="OpportunityName" class="form-label">Opportunity Name *</label>
            <input asp-for="OpportunityName" class="form-control" placeholder="Annual Software Contract" />
            <span asp-validation-for="OpportunityName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Select Customer *</label>
            <select asp-for="CustomerId" class="form-select" required>
                <option value="">-- Choose Customer --</option>
                @if (ViewBag.Customers != null)
                {
                    foreach (var c in ViewBag.Customers)
                    {
                        <option value="@c.CustomerId">@c.CustomerName (@c.Email)</option>
                    }
                }
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="Amount" class="form-label">Amount (₹) *</label>
            <input asp-for="Amount" type="number" step="0.01" class="form-control" placeholder="50000" />
            <span asp-validation-for="Amount" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Probability" class="form-label">Probability (0 to 100)% *</label>
            <input asp-for="Probability" type="number" class="form-control" placeholder="75" />
            <span asp-validation-for="Probability" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Stage" class="form-label">Pipeline Stage *</label>
            <select asp-for="Stage" class="form-select">
                <option value="Qualification">Qualification</option>
                <option value="Proposal">Proposal</option>
                <option value="Negotiation">Negotiation</option>
                <option value="Won">Won</option>
                <option value="Lost">Lost</option>
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="ExpectedCloseDate" class="form-label">Expected Close Date *</label>
            <input asp-for="ExpectedCloseDate" type="date" class="form-control" />
            <span asp-validation-for="ExpectedCloseDate" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success">Save Opportunity</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>