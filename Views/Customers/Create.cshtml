@model AcxiomCRM.Models.Customer

@{
    ViewData["Title"] = "Create Customer";
}

<div class="container mt-4" style="max-width: 650px;">
    <h2>Add New Customer</h2>
    <hr />
    
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="CustomerName" class="form-label">Full Name *</label>
            <input asp-for="CustomerName" class="form-control" placeholder="John Doe" />
            <span asp-validation-for="CustomerName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email Address *</label>
            <input asp-for="Email" type="email" class="form-control" placeholder="john@example.com" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Phone" class="form-label">Phone (10 digits) *</label>
            <input asp-for="Phone" class="form-control" placeholder="9876543210" />
            <span asp-validation-for="Phone" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="CompanyName" class="form-label">Company Name</label>
            <input asp-for="CompanyName" class="form-control" placeholder="Acme Corp" />
            <span asp-validation-for="CompanyName" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success">Save Customer</button>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </form>
</div>