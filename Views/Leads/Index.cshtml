@model IEnumerable<AcxiomCRM.Models.Lead>

@{
    ViewData["Title"] = "Lead Management";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Lead Management</h2>
        <a asp-action="Create" class="btn btn-primary">+ New Lead</a>
    </div>

    <table class="table table-bordered table-striped shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Code</th>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Company</th>
                <th>Status</th>
                <th>Expected Value</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td><strong>@item.LeadCode</strong></td>
                    <td>@item.LeadName</td>
                    <td>@item.Email</td>
                    <td>@item.Phone</td>
                    <td>@(item.CompanyName ?? "-")</td>
                    <td>
                        <span class="badge @(item.Status == "Converted" ? "bg-success" : "bg-warning text-dark")">
                            @item.Status
                        </span>
                    </td>
                    <td>₹@item.ExpectedValue.ToString("N0")</td>
                    <td>
                        @if (item.Status != "Converted")
                        {
                            <form asp-action="Convert" asp-route-id="@item.LeadId" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-success">Convert to Customer</button>
                            </form>
                        }
                        else
                        {
                            <span class="text-muted small">Converted</span>
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="8" class="text-center text-muted">No leads available.</td>
            </tr>
        }
        </tbody>
    </table>
</div>