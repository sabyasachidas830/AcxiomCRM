@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid mt-3">
    <h2 class="mb-4">AcxiomCRM Sales Dashboard</h2>

    <!-- KPI Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white shadow-sm">
                <div class="card-body">
                    <h6>Total Customers</h6>
                    <h2 class="fw-bold">@ViewBag.TotalCustomers</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white shadow-sm">
                <div class="card-body">
                    <h6>Total Leads</h6>
                    <h2 class="fw-bold">@ViewBag.TotalLeads</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-dark shadow-sm">
                <div class="card-body">
                    <h6>Open Opportunities</h6>
                    <h2 class="fw-bold">@ViewBag.OpenOpportunities</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white shadow-sm">
                <div class="card-body">
                    <h6>Pipeline Value</h6>
                    <h2 class="fw-bold">₹@ViewBag.TotalPipelineValue.ToString("N0")</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Chart.js Opportunity Pipeline -->
    <div class="card shadow-sm p-4 col-md-8">
        <h5>Opportunity Pipeline Stages</h5>
        <canvas id="pipelineChart" height="120"></canvas>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const ctx = document.getElementById('pipelineChart').getContext('2d');
    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: ['Qualification', 'Proposal', 'Negotiation', 'Won', 'Lost'],
            datasets: [{
                label: 'Opportunities',
                data: [
                    @ViewBag.StageQualification,
                    @ViewBag.StageProposal,
                    @ViewBag.StageNegotiation,
                    @ViewBag.StageWon,
                    @ViewBag.StageLost
                ],
                backgroundColor: ['#0d6efd', '#0dcaf0', '#ffc107', '#198754', '#dc3545']
            }]
        },
        options: {
            responsive: true,
            scales: {
                y: { beginAtZero: true, ticks: { precision: 0 } }
            }
        }
    });
</script>